# Copy to site/.env; never commit actual credentials.
BASE_URL=http://localhost:5173
HOST=127.0.0.1
PORT=4173
# Production: NODE_ENV=production and BASE_URL=https://your-domain.example
NODE_ENV=development
# Use an absolute path on a persistent disk in production.
# DATABASE_PATH=/srv/handout-data/community.sqlite
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ADMIN_API_KEY=
# PYTHON_PATH=python

SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
